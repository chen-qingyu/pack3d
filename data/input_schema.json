{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hypercube Input Schema",
  "description": "3D 装箱问题输入的 JSON Schema",
  "type": "object",
  "required": ["container_types", "box_types", "boxes"],
  "additionalProperties": false,
  "properties": {
    "container_types": {
      "type": "array",
      "description": "容器类型列表",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "inner_size"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "inner_size": {
            "type": "object",
            "required": ["x", "y", "z"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "integer", "minimum": 1 },
              "y": { "type": "integer", "minimum": 1 },
              "z": { "type": "integer", "minimum": 1 }
            }
          },
          "max_weight": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "quantity_limit": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "box_types": {
      "type": "array",
      "description": "箱子类型列表",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "size", "allowed_orientations"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "size": {
            "type": "object",
            "required": ["x", "y", "z"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "integer", "minimum": 1 },
              "y": { "type": "integer", "minimum": 1 },
              "z": { "type": "integer", "minimum": 1 }
            }
          },
          "allowed_orientations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["xyz", "xzy", "yxz", "yzx", "zxy", "zyx"]
            }
          }
        }
      }
    },
    "boxes": {
      "type": "array",
      "description": "箱子实例列表",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "box_type_id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "box_type_id": { "type": "string" },
          "weight": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "group": { "type": "string" },
          "platform": { "type": "string" }
        }
      }
    },
    "route": {
      "type": "array",
      "description": "路线顺序：按装货顺序排列的平台 ID（先装平台在深处 X 小，后装平台在近门处 X 大）",
      "items": { "type": "string" }
    },
    "algorithm": {
      "type": "object",
      "description": "算法配置",
      "additionalProperties": false,
      "properties": {
        "use": {
          "type": "string",
          "enum": ["sgep", "mlhs"],
          "default": "sgep"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mlhs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 27,
                  "description": "前瞻宽度：每步评估的候选块数上限（越大搜索越充分，耗时线性增长）"
                }
              }
            },
            "sgep": {
              "type": "object"
            }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "description": "目标函数键列表（按优先级排序）",
      "default": [
        "min_container_count",
        "min_platform_count",
        "max_volume_rate",
        "min_group_split"
      ],
      "items": {
        "type": "string",
        "enum": [
          "min_container_count",
          "min_platform_count",
          "max_volume_rate",
          "min_group_split"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "description": "约束配置",
      "additionalProperties": false,
      "properties": {
        "time_limit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 120
        },
        "support_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "platform_limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "tender_limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        }
      }
    }
  }
}
