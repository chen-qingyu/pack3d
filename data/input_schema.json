{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pack3d Input Schema",
  "description": "3D 装箱问题输入的 JSON Schema",
  "type": "object",
  "required": ["container_types", "box_types", "boxes"],
  "additionalProperties": false,
  "properties": {
    "container_types": {
      "type": "array",
      "description": "容器类型列表",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "inner_size"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "inner_size": {
            "type": "object",
            "required": ["x", "y", "z"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "integer", "minimum": 1 },
              "y": { "type": "integer", "minimum": 1 },
              "z": { "type": "integer", "minimum": 1 }
            }
          },
          "max_weight": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "quantity_limit": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "box_types": {
      "type": "array",
      "description": "箱子类型列表",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "size", "allowed_orientations"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "size": {
            "type": "object",
            "required": ["x", "y", "z"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "integer", "minimum": 1 },
              "y": { "type": "integer", "minimum": 1 },
              "z": { "type": "integer", "minimum": 1 }
            }
          },
          "allowed_orientations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["xyz", "xzy", "yxz", "yzx", "zxy", "zyx"]
            }
          },
          "max_stack": {
            "description": "堆码层数上限：标量（全部朝向）或数组（与 allowed_orientations 对齐）；null=不限",
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              {
                "type": "array",
                "items": { "type": ["integer", "null"], "minimum": 1 }
              }
            ]
          },
          "max_load": {
            "description": "单箱上方可承受总重量上限：标量（全部朝向）或数组（与 allowed_orientations 对齐）；null=不限",
            "oneOf": [
              { "type": "number", "minimum": 0 },
              {
                "type": "array",
                "items": { "type": ["number", "null"], "minimum": 0 }
              }
            ]
          }
        }
      }
    },
    "boxes": {
      "type": "array",
      "description": "箱子实例列表",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "box_type_id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "box_type_id": { "type": "string" },
          "weight": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "group": { "type": "string" },
          "platform": { "type": "string" }
        }
      }
    },
    "route": {
      "type": "array",
      "description": "路线顺序：按装货顺序排列的平台 ID（先装平台在深处 X 小，后装平台在近门处 X 大）",
      "items": { "type": "string" }
    },
    "algorithm": {
      "type": "string",
      "description": "求解算法",
      "enum": ["gep", "glc", "rgs", "bsg"],
      "default": "gep"
    },
    "constraints": {
      "type": "object",
      "description": "约束配置",
      "additionalProperties": false,
      "properties": {
        "time_limit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 120
        },
        "support_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "platform_limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "tender_limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        }
      }
    },
    "existing_containers": {
      "type": "array",
      "description": "已有的中间状态容器，其中箱子不再出现在 boxes 列表中",
      "items": {
        "type": "object",
        "required": ["type_id", "placements"],
        "additionalProperties": false,
        "properties": {
          "type_id": { "type": "string" },
          "placements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["box_id", "box_type_id", "position", "orientation"],
              "additionalProperties": false,
              "properties": {
                "box_id": { "type": "string" },
                "box_type_id": { "type": "string" },
                "position": {
                  "type": "object",
                  "required": ["x", "y", "z"],
                  "additionalProperties": false,
                  "properties": {
                    "x": { "type": "integer", "minimum": 0 },
                    "y": { "type": "integer", "minimum": 0 },
                    "z": { "type": "integer", "minimum": 0 }
                  }
                },
                "orientation": {
                  "type": "string",
                  "enum": ["xyz", "xzy", "yxz", "yzx", "zxy", "zyx"]
                },
                "size": {
                  "type": "object",
                  "required": ["dx", "dy", "dz"],
                  "additionalProperties": false,
                  "properties": {
                    "dx": { "type": "integer", "minimum": 1 },
                    "dy": { "type": "integer", "minimum": 1 },
                    "dz": { "type": "integer", "minimum": 1 }
                  }
                },
                "weight": { "type": ["number", "null"], "exclusiveMinimum": 0 },
                "group": { "type": ["string", "null"] },
                "platform": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
