{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pack3d Input Schema",
  "type": "object",
  "required": ["container_types", "box_types", "boxes"],
  "additionalProperties": false,
  "properties": {
    "container_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sx", "sy", "sz"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "sx": { "type": "integer", "minimum": 1 },
          "sy": { "type": "integer", "minimum": 1 },
          "sz": { "type": "integer", "minimum": 1 },
          "max_weight": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "quantity_limit": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "box_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sx", "sy", "sz", "allowed_orientations"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "sx": { "type": "integer", "minimum": 1 },
          "sy": { "type": "integer", "minimum": 1 },
          "sz": { "type": "integer", "minimum": 1 },
          "allowed_orientations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["xyz", "xzy", "yxz", "yzx", "zxy", "zyx"]
            }
          },
          "max_stack": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              {
                "type": "array",
                "items": { "type": ["integer", "null"], "minimum": 1 }
              }
            ]
          },
          "max_load": {
            "oneOf": [
              { "type": "number", "minimum": 0 },
              {
                "type": "array",
                "items": { "type": ["number", "null"], "minimum": 0 }
              }
            ]
          }
        }
      }
    },
    "boxes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "box_type_id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "box_type_id": { "type": "string" },
          "weight": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "group": { "type": "string" },
          "platform": { "type": "string" }
        }
      }
    },
    "route": {
      "type": "array",
      "items": { "type": "string" }
    },
    "algorithm": {
      "type": "string",
      "enum": ["gep", "glc", "rgs", "bsg"],
      "default": "gep"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_limit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 120
        },
        "support_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "platform_limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "tender_limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        }
      }
    },
    "existing_containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type_id", "placements"],
        "additionalProperties": false,
        "properties": {
          "type_id": { "type": "string" },
          "placements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "box_id",
                "box_type_id",
                "x",
                "y",
                "z",
                "orientation"
              ],
              "additionalProperties": false,
              "properties": {
                "box_id": { "type": "string" },
                "box_type_id": { "type": "string" },
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "z": { "type": "integer", "minimum": 0 },
                "orientation": {
                  "type": "string",
                  "enum": ["xyz", "xzy", "yxz", "yzx", "zxy", "zyx"]
                },
                "dx": { "type": "integer", "minimum": 1 },
                "dy": { "type": "integer", "minimum": 1 },
                "dz": { "type": "integer", "minimum": 1 },
                "weight": { "type": ["number", "null"], "exclusiveMinimum": 0 },
                "group": { "type": ["string", "null"] },
                "platform": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
